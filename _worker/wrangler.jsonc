{
  "name": "omkar-firm-editor",
  "main": "worker.mjs",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "vars": { "REPOSITORY": "anshikapandey-small/CA-Omkar_Kharade", "BRANCH": "main" },
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }]
}
